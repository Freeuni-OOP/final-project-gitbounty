# Database - Spring Boot uses these specific names
SPRING_DATASOURCE_URL=jdbc:mysql://gitbounty-db-do-user-39031824-0.g.db.ondigitalocean.com:25060/gitbounty?ssl-mode=REQUIRED
SPRING_DATASOURCE_USERNAME=flyway_user
SPRING_DATASOURCE_PASSWORD=

# Flyway
FLYWAY_USER=flyway_user
FLYWAY_PASSWORD=
FLYWAY_DEFAULT_SCHEMA=gitbounty

# Keycloak
KEYCLOAK_CLIENT_ID=gitbounty-backend
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER_URI=https://auth.gitbounty.foo/realms/gitbounty
KEYCLOAK_HOSTNAME=auth.gitbounty.foo

# App Features
SWAGGER_ENABLED=true
SWAGGER_OAUTH_CLIENT_ID=gitbounty-frontend

BRANCH_NAME=develop

OPENAI_API_KEY=

DOMAIN=gitbounty.foo