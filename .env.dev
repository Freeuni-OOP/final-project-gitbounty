# Database
DB_ROOT_PASSWORD=root_password
DB_USER=dev_user
DB_PASSWORD=dev_password

# Keycloak
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/gitbounty
KEYCLOAK_CLIENT_ID=gitbounty-backend
KEYCLOAK_CLIENT_SECRET=gitbounty-backend-secret

# Development: use the dev command
KC_COMMAND= start-dev --import-realm

#Backend
FLYWAY_USER=root
FLYWAY_PASSWORD=root_password

SWAGGER_ENABLED=true
SWAGGER_OAUTH_CLIENT_ID=gitbounty-frontend

BRANCH_NAME=develop